BACKUP_KEEP_DAYS=7
SCHEDULE=@daily
PGDUMP_EXTRA_OPTS=""
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# WebDAV / cloud storage settings
# CLOUD_TYPE: nextcloud or owncloud (default: owncloud)
CLOUD_TYPE=nextcloud
WEBDAV_FQDN=cloud.example.com
WEBDAV_SHARE_ID=share_token
WEBDAV_SHARE_PASSWORD=share_password

PASSPHRASE=loremipsum
GPG_EMAILS=johndoe@domain.tld
GPG_TRUST_MODEL=auto
GPG_KEY_LOCATE=wkd
GPG_RESTORE_EMAIL=johndoe@domain.tld
GPG_RESTORE_EMAIL_PASSPHRASE=johndoe@domain.tld_passphrase
